{$DOMAIN:localhost} {
	encode zstd gzip

	# The API (including the Concierge's streamed answers) goes to the backend.
	handle /api/* {
		reverse_proxy backend:8001 {
			flush_interval -1
		}
	}

	# The CYGEN Website CMS (a separate stack, reached over the "edge" network): the signed draft preview and the uploaded pictures,
	# (the published release at /cms-api/release keeps the ETag and Cache-Control the API sets: reverse_proxy passes them through unchanged),
	# read only, at the site's own address so the browser makes no cross-site request. Nothing changes for visitors without a preview link.
	@cmswrite not method GET HEAD
	handle_path /cms-api/* {
		respond @cmswrite 405
		rewrite * /v1/public/cms{uri}
		reverse_proxy cygen-api:8000
	}
	handle_path /cms-media/* {
		respond @cmswrite 405
		rewrite * /v1/public/cms/media{uri}
		reverse_proxy cygen-api:8000
	}

	# Everything else is the single-page app.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

# The CYGEN software (a separate stack on the same VM). Caddy reaches it over the external docker network "edge", which the
# server's docker-compose.override.yml attaches to this service; the upstream names are resolved when a request arrives, so this
# file is harmless where that stack or network does not exist.
app.{$DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy cygen-web:3000
}

api.{$DOMAIN:localhost} {
	encode zstd gzip
	# /metrics has no credential in that stack: never expose it on the internet
	@metrics path /metrics /metrics/*
	respond @metrics 404
	reverse_proxy cygen-api:8000
}
